.venv/
node_modules/
__pycache__/
*.pyc
*.db
*.db.bak*
reports/*.html
evidence/*
# real engagement config carries target + test-account tokens — never commit it
config/engagement.json
# user API-key hashes and the live egress allowlist are per-deployment secrets
config/users.json
docker/allowlist
.env
# backups of .env are secrets too - the bare ".env" rule does not match them
.env.bak*
