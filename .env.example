# ---------------------------------------------------------------------------
# Copy to .env.  Every setting in this platform has a working default, so the
# short version is: set the two persona tokens below, add the Jira block if you
# import real tickets, and ignore the rest.
#
# The full list — every variable, its default, and when it is worth changing —
# is docs/configuration.md.  It is a reference, not a checklist: nothing there
# is required to get a first run working.
# ---------------------------------------------------------------------------

# ---- Test-account credentials (the one thing you normally must set) --------
# config/engagement.json references these as "Bearer ${PERSONA_A_TOKEN}", so no
# credential lands in that file — it stays a reviewable, pasteable artifact.
# Unset means the header is withheld and readiness blocks the run, because a
# 401 from a missing variable is indistinguishable in a report from a 401 the
# endpoint meant to return.  Use dedicated test accounts.
PERSONA_A_TOKEN=
PERSONA_B_TOKEN=

# ---- Jira (optional — an offline mock is used while these are unset) -------
# JIRA_MCP_URL=https://mcp.atlassian.com/v1/mcp
# JIRA_CLOUD_ID=
# JIRA_MCP_TOKEN=
# JIRA_SITE_URL=https://yourcompany.atlassian.net

# ---- AI analyzer (optional) -----------------------------------------------
# Runs `claude -p` under your own Claude Code login — no ANTHROPIC_API_KEY and
# no anthropic package.  Off means the deterministic analyzer, which is what
# every test in this repo runs against.
USE_AI=false

# ---- Occasionally useful; the value shown is already the default ----------
# ENGAGEMENT_CONFIG=config/engagement.json
# DATABASE_URL=sqlite:///sectest.db
# LOG_LEVEL=INFO
# AUTH_ENABLED=false
# PLATFORM_BASE_URL=          # so the Jira comment can link to the HTML report

# Runner limits, OAST, report signing, multi-user auth, the arbitrary-Python
# sandbox, Postgres pooling and Sentry: docs/configuration.md.  Several of them
# are also editable in the UI under Configuration → Advanced, which writes back
# to this file and applies immediately.

# --- Engagements -----------------------------------------------------------
# One engagement, the single-file form every existing install uses:
ENGAGEMENT_CONFIG=config/engagement.json
# Or a directory, one file per client, each named after its file stem. Both may
# be set. Neither set means no engagements at all — discovery never happens on
# its own, because a config file existing on disk is not the deliberate act
# default-deny asks for.
# ENGAGEMENTS_DIR=config/engagements

# --- Runner ----------------------------------------------------------------
# How many approved tests run at once. 1 is strictly sequential. Raising it
# speeds a long plan up close to linearly, at proportionally higher request rate
# against the target — a blast-radius decision, so it is not raised for you.
# RUNNER_MAX_CONCURRENT_TESTS=1
