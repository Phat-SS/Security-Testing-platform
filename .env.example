# ---- Logging ----
# Every logger in the process runs through a redaction filter (the same
# secret-shape/key-name patterns as app/core/redaction.py) as a second,
# independent guard against a stray log line leaking what the report/export/
# Jira-comment redaction pass already protects. See app/core/logging_config.py.
LOG_LEVEL=INFO
# Optional: send unhandled exceptions to Sentry (pip install sentry-sdk).
# Off unless both this is set AND the package is installed; events are
# redacted the same way before being sent.
# SENTRY_DSN=

# ---- Runner guardrails ----
RUNNER_TIMEOUT_S=15
RUNNER_MAX_RESPONSE_BYTES=2000000
RUNNER_MAX_REQUESTS_PER_TEST=25

# ---- Scope safety ----
# Keep FALSE except for a local lab. When false, any target resolving to a
# private/loopback/link-local IP is blocked (SSRF/metadata protection). The
# engagement.json can also opt in per-engagement.
ALLOW_PRIVATE_RANGES=false

# ---- Engagement (authorized target + scope + personas) ----
# Execution is disabled until this points at a valid config file.
ENGAGEMENT_CONFIG=config/engagement.json

# ---- Persistence ----
# Default is a local SQLite file. Set a DSN for PostgreSQL.
DATABASE_URL=sqlite:///sectest.db
# Connection pool, Postgres only (SQLite has no server-side pool to tune).
# Defaults are sane for a single instance; raise pool_size for more concurrent
# workers, lower pool_recycle if a proxy/firewall in front of Postgres closes
# idle connections sooner than this.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE_S=1800

# ---- AI analyzer (optional) ----
# When USE_AI=true and the `claude` CLI is installed and logged in (Claude
# Code), the Claude analyzer replaces the deterministic one; on any failure
# it falls back automatically. This runs `claude -p` under the operator's own
# Claude Code login/subscription — no separate ANTHROPIC_API_KEY needed, and
# no anthropic pip package either.
USE_AI=false
# ANTHROPIC_MODEL=            # optional: force a specific model; unset uses
                              # the CLI's own default (same as your interactive session)
# CLAUDE_CLI_PATH=claude     # optional: path to the claude binary if not on PATH

# The same switch turns on the AI half of both reviewing agents: the plan
# reviewer (audits a generated plan against the ticket's requirements and feeds
# its gaps back to the planner) and the result adjudicator (reads the response
# body of a result the runner left undecided). Both keep working with USE_AI
# false - the plan reviewer falls back to a structural review, and the
# adjudicator to deterministic triage, which is where most of its value is.

# ---- Where this platform is reachable from (optional) ----
# Used only to put a working link to the HTML report in the Jira comment. The
# comment now carries the summary and the results table and points at the report
# for the per-test explanation, so a reader needs a way to get there. Unset means
# no link rather than a localhost URL that 404s for every reader but its author.
# PLATFORM_BASE_URL=https://sectest.internal.example

# ---- Live Jira MCP (Phase 3) ----
# Set JIRA_MCP_URL to switch off the offline mock (requires: pip install mcp).
# If the server is unreachable the app logs a warning and falls back to the mock
# instead of failing to start.
#   JIRA_MCP_URL    Streamable-HTTP endpoint, e.g. https://mcp.atlassian.com/v1/mcp
#   JIRA_CLOUD_ID   from the MCP server's getAccessibleAtlassianResources tool
#   JIRA_MCP_TOKEN  OAuth access token -> sent as Authorization: Bearer <token>
#   JIRA_MCP_HEADERS  JSON object of extra headers, for non-bearer schemes
#   JIRA_SITE_URL   Human browse URL, e.g. https://yourcompany.atlassian.net —
#                   powers the "Open ticket" link shown after posting a
#                   comment. JIRA_CLOUD_ID is a UUID, not a hostname, so it
#                   can't build this link on its own.
# Keep the token in the environment only — never in engagement.json or a report.
# JIRA_MCP_URL=
# JIRA_CLOUD_ID=
# JIRA_MCP_TOKEN=
# JIRA_MCP_HEADERS={"X-Custom":"value"}
# JIRA_SITE_URL=
# Tool-name overrides, if your MCP server names them differently:
# JIRA_TOOL_GET=getJiraIssue
# JIRA_TOOL_SEARCH=searchJiraIssuesUsingJql
# JIRA_TOOL_COMMENT=addCommentToJiraIssue

# ---- Multi-user auth (optional) ----
# When false, the app runs open in single-user (local-admin) mode. When true,
# mutating routes require a valid API key from config/users.json.
AUTH_ENABLED=false
AUTH_USERS_CONFIG=config/users.json

# ---- Arbitrary-Python PoC runner (opt-in, isolation required) ----
# OFF by default. All must be set (and PoC marked reviewed) to run arbitrary
# Python. Scope for arbitrary code is enforced by the egress proxy, not the app.
# INSIDE_SECURITY_SANDBOX must ALSO be true — it is set automatically by
# docker/Dockerfile.sandbox and must never be set by hand outside that
# container: an egress proxy env var alone is not a security boundary for
# arbitrary code on a bare host.
ENABLE_PYTHON_RUNNER=false
# EGRESS_PROXY=http://egress:8888
# INSIDE_SECURITY_SANDBOX=true
PYTHON_RUNNER_TIMEOUT_S=10

# ---- Persona credentials ----
# Real test-account tokens for the personas in config/engagement.json, which
# references them as "Authorization": "Bearer ${DEV_CRM_TOKEN_A}" rather than
# holding the value. Bare token here; the "Bearer " prefix stays in the config.
# Unset or empty means the header is withheld and readiness blocks the run, so
# a missing credential can never be mistaken for a target that returns 401.
DEV_CRM_TOKEN_A=
DEV_CRM_TOKEN_B=
